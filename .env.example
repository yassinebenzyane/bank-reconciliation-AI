# Clé API Mistral (https://console.mistral.ai)
MISTRAL_API_KEY=

# Fournisseur LLM : "mistral_api" (défaut) ou "ollama" (local, zéro coût)
# Swap sans toucher au code agent — juste changer cette variable
LLM_PROVIDER=mistral_api

# Paths optionnels (par défaut relatifs au repo)
DATA_INPUT_DIR=data/input
DATA_OUTPUT_DIR=data/output
HISTORY_PATH=data/history.json
